<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface_white">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="62dp" android:paddingHorizontal="12dp" android:paddingVertical="10dp" android:gravity="center_vertical">
<ImageView android:id="@+id/viewCategoryColor" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/mint_chip" android:padding="9dp" android:src="@drawable/ic_mint_basket" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:orientation="vertical">
<TextView android:id="@+id/tvExpenseTitle" style="@style/Mint.Body" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/tvExpenseCategoryAndDate" style="@style/Mint.Subtitle" android:textSize="12sp" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/tvExpenseNote" style="@style/Mint.Subtitle" android:visibility="gone"/>
</LinearLayout>
<TextView android:id="@+id/tvExpenseAmount" style="@style/Mint.Body" android:textStyle="bold"/>
<ImageButton android:id="@+id/btnDeleteExpense" android:contentDescription="@string/btn_delete" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout><View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider_color"/>
</LinearLayout>